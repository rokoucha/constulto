{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rokoucha/constulto/schema/project-config.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["version"],
  "properties": {
    "version": {"const": 1},
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agent": {"type": "string", "minLength": 1},
        "timeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 86400},
        "maxConcurrency": {"type": "integer", "minimum": 1, "maximum": 16},
        "maxFollowups": {"type": "integer", "minimum": 0, "maximum": 10}
      }
    },
    "exclude": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  }
}
